# Skopiuj do .env i uzupełnij

# Wideo ze stocku — wystarczy jeden z tych kluczy (Pixabay jest darmowy i dostępny od razu):
# https://pixabay.com/accounts/register/ -> potem https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels: nowe klucze są chwilowo wstrzymane, zostaw puste jeśli nie masz
PEXELS_API_KEY=

VOICE=pl-PL-MarekNeural
VOICE_RATE=+8%

# opcjonalnie: powiadomienia z bota @Agencja_robot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=798730878
